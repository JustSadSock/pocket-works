{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-works",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "run_worker_first": ["/pocketnet/*", "/pocket-id/*", "/pocket-cloud/*", "/pocket-social/*", "/ai-assets/*", "/privacy"]
  },
  "main": "./pocketnet/worker.mjs",
  "durable_objects": {
    "bindings": [
      { "name": "POCKETNET", "class_name": "PocketNetHub" },
      { "name": "POCKET_ID", "class_name": "PocketIdentity" },
      { "name": "POCKET_CLOUD", "class_name": "PocketCloud" },
      { "name": "POCKET_SOCIAL", "class_name": "PocketSocial" }
    ]
  },
  "migrations": [
    { "tag": "pocketnet-sqlite-v1", "new_sqlite_classes": ["PocketNetHub"] },
    { "tag": "pocket-id-sqlite-v1", "new_sqlite_classes": ["PocketIdentity"] },
    { "tag": "pocket-cloud-sqlite-v1", "new_sqlite_classes": ["PocketCloud"] },
    { "tag": "pocket-social-sqlite-v1", "new_sqlite_classes": ["PocketSocial"] }
  ]
}
