{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-works",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/pocketnet/*"
    ]
  },
  "main": "./pocketnet/worker.mjs",
  "durable_objects": {
    "bindings": [
      {
        "name": "POCKETNET",
        "class_name": "PocketNetHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pocketnet-sqlite-v1",
      "new_sqlite_classes": [
        "PocketNetHub"
      ]
    }
  ]
}
