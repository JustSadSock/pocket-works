        "tests/world.test.mjs",
        "tests/dynasty.test.mjs",
        "tests/politics.test.mjs",
        "tests/campaign.test.mjs",
        "tests/atlas.test.mjs",
        "tests/conflicts.test.mjs",
        "tests/scale.test.mjs",
        "tests/refinement.test.mjs",
        "tests/legacy.test.mjs"
      ]
    },
    {
