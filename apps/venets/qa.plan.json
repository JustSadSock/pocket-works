      "args": [
        "--seeds=100",
        "--years=50",
        "--output={output}/venets-100x50.json"
      ]
    },
    {
      "id": "world-century",
      "kind": "node",
      "tier": "smoke",
      "entry": "qa/stress.mjs",
      "args": [
        "--seeds=100",
        "--years=100",
        "--output={output}/venets-100x100.json"
      ]
    },
    {
      "id": "dossier-visual",
      "kind": "visual",
      "tier": "smoke",
      "viewports": [
        "mobile",
        "desktop"
      ],
      "ready": "#open-docs",
      "steps": [
        {
          "action": "click",
          "selector": "#open-docs"
        },
        {
          "action": "click",
          "selector": "[data-doc=\"RESEARCH.md\"]"
        },
        {
          "action": "visible",
          "selector": "#document"
        },
        {
          "action": "screenshot"
        }
      ],
      "engines": [
        "chromium",
        "webkit"
      ]
    },
    {
      "id": "campaign-mobile-first-year",
      "kind": "visual",
      "tier": "smoke",
      "viewports": [
        "mobile",
        "desktop"
      ],
      "engines": [
        "chromium",
        "webkit"
      ],
      "ready": "#begin",
      "steps": [
        {
          "action": "click",
          "selector": "#begin"
        },
        {
          "action": "visible",
          "selector": "#game-screen"
        },
        {
          "action": "screenshot"
        },
        {
          "action": "click",
          "selector": ".action-choice"
        },
        {
          "action": "visible",
          "selector": "#confirm-dialog"
        },
        {
          "action": "click",
          "selector": "#confirm-approve"
        },
        {
          "action": "click",
          "selector": "#next-year"
        },
        {
          "action": "visible",
          "selector": "#year-count"
        },
        {
          "action": "screenshot"
        }
      ]
    },
    {
      "id": "inspector-real-previews",
