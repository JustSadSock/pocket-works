      ]
    },
    {
      "id": "scale-study-2x2",
      "kind": "node",
      "tier": "smoke",
      "entry": "qa/scale-study.mjs",
      "args": [
        "--output={output}/venets-scale-study.json"
      ]
    }
  ]
