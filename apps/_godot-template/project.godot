; Pocket Works Godot Web template.
; Generated apps are authored as text and exported headlessly in GitHub Actions.

config_version=5

[application]

config/name="__APP_NAME__"
run/main_scene="res://source/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0627451, 0.0666667, 0.0588235, 1)

[autoload]

PocketWorks="*res://source/pocket_works.gd"

[display]

window/size/viewport_width=1170
window/size/viewport_height=2532
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
