NODE_ENV=production
PORT=8788
# Bind Node.js only to loopback; Caddy provides the public HTTPS endpoint.
POCKET_HOST=127.0.0.1
POCKET_DATA_DIR=/var/lib/pocket-server
POCKET_AUTH_SECRET=replace-with-a-long-random-value
POCKET_DEPLOY_TOKEN=replace-with-a-different-long-random-value
POCKET_ALLOWED_ORIGINS=https://your-pocketworks-domain.example
POCKET_MAX_ROOMS=32
POCKET_MAX_CONNECTIONS=48
